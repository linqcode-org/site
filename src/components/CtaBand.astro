---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import { company } from "../data/site";
---

<section class="cta on-night">
  <div class="wrap cta-grid">
    <Mark id="cta" class="cta-mark" />
    <div class="cta-copy">
      <h2>Tudo certo! Vamos começar.</h2>
      <p class="soft">Envie seus dados que entraremos em contato com você.</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary" href="/contato">Entre em contato</a>
      <a class="btn btn-quiet" href={company.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }
  .cta-grid {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .cta :global(.cta-mark) {
    width: clamp(64px, 8vw, 96px);
  }
  .cta-copy {
    display: grid;
    gap: 0.5rem;
  }
  .cta-copy h2 {
    font-size: var(--step-3);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 820px) {
    .cta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
