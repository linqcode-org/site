---
// The Linqcode symbol redrawn as SVG from the brand file (linqcode-logorgb1.png): an orange disc, four
// half-disc "petals" fading from red at the square to orange at the tip, and the white square they link.
// `assemble` lets the hero play the one page-load motion: the petals swing in and lock around the square.
interface Props {
  id: string;
  class?: string;
  assemble?: boolean;
  title?: string;
}
const { id, class: className, assemble = false, title } = Astro.props;
const R = 29.46;
const petals = [
  { d: `M33.33 66.59A${R} ${R} 0 0 1 33.33 7.66Z`, from: [33.33, 66.59], to: [33.33, 7.66] },
  { d: `M33.33 33.33A${R} ${R} 0 0 1 92.26 33.33Z`, from: [33.33, 33.33], to: [92.26, 33.33] },
  { d: `M66.59 33.33A${R} ${R} 0 0 1 66.59 92.26Z`, from: [66.59, 33.33], to: [66.59, 92.26] },
  { d: `M66.59 66.59A${R} ${R} 0 0 1 7.66 66.59Z`, from: [66.59, 66.59], to: [7.66, 66.59] },
];
---

<svg
  class:list={["mark", className, { assemble }]}
  viewBox="0 0 100 100"
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  aria-label={title}
  focusable="false"
>
  <defs>
    {
      petals.map((p, i) => (
        <linearGradient
          id={`${id}-g${i}`}
          gradientUnits="userSpaceOnUse"
          x1={p.from[0]}
          y1={p.from[1]}
          x2={p.to[0]}
          y2={p.to[1]}
        >
          <stop offset="0" stop-color="#D2353A" />
          <stop offset="0.72" stop-color="#FF6000" />
        </linearGradient>
      ))
    }
    <clipPath id={`${id}-c`}><circle cx="50" cy="50" r="50" /></clipPath>
  </defs>
  <circle class="disc" cx="50" cy="50" r="50" fill="#FF6000" />
  <g clip-path={`url(#${id}-c)`}>
    {petals.map((p, i) => <path class={`petal p${i}`} d={p.d} fill={`url(#${id}-g${i})`} />)}
  </g>
  <rect class="core" x="33.33" y="33.33" width="33.26" height="33.26" fill="#fff" />
</svg>

<style>
  .mark {
    display: block;
    overflow: visible;
  }
  .petal {
    transform-box: view-box;
    transform-origin: 50px 50px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .assemble .disc {
      animation: disc 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .assemble .petal {
      animation: petal 1100ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .assemble .p0 { --dx: -14px; --dy: 6px; animation-delay: 120ms; }
    .assemble .p1 { --dx: 6px; --dy: -14px; animation-delay: 200ms; }
    .assemble .p2 { --dx: 14px; --dy: 6px; animation-delay: 280ms; }
    .assemble .p3 { --dx: -6px; --dy: 14px; animation-delay: 360ms; }
    .assemble .core {
      transform-box: fill-box;
      transform-origin: center;
      animation: core 700ms cubic-bezier(0.3, 1.4, 0.4, 1) 650ms both;
    }
  }
  @keyframes disc {
    from { opacity: 0; transform: scale(0.6); transform-origin: 50px 50px; }
    to { opacity: 1; transform: scale(1); transform-origin: 50px 50px; }
  }
  @keyframes petal {
    from { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(-60deg); }
    to { opacity: 1; transform: none; }
  }
  @keyframes core {
    from { transform: scale(0) rotate(-45deg); }
    to { transform: none; }
  }
</style>
