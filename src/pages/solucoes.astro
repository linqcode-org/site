---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import ServiceArt from "../components/ServiceArt.astro";
import Icon from "../components/Icon.astro";
import CtaBand from "../components/CtaBand.astro";
import { allServices as services, solutionsIntro } from "../data/site";
import { servicesLd, breadcrumbLd } from "../data/structured";
---

<Base
  title="Soluções: sites, e-commerce, apps, sistemas, IA e cloud | Linqcode"
  description="Site institucional, e-commerce, aplicativos Android e iOS, aplicações customizadas, inteligência artificial e cloud, com hospedagem, suporte e manutenção. Conheça as soluções da Linqcode."
  schema={[...servicesLd(), breadcrumbLd([{ name: "Soluções", path: "/solucoes" }])]}
>
  <PageHead crumb="Soluções" title="Conheça nossas soluções" lede={solutionsIntro} petal={1}>
    <ul class="jump" aria-label="Ir para">
      {services.map((s) => <li><a href={`#${s.anchor}`}>{s.name}</a></li>)}
    </ul>
  </PageHead>

  {
    services.map((s, i) => (
      <section id={s.anchor} class:list={["service", { flip: i % 2 === 1 }]}>
        <div class="wrap service-grid">
          <div class="service-art">
            <ServiceArt service={s.key} size={340} />
          </div>
          <div class="service-copy">
            <h2>{s.name}</h2>
            <p class="pitch">{s.pitch}</p>
            <ul class="features">
              {s.features.map((f) => (
                <li>
                  <Icon name="check" />
                  {f}
                </li>
              ))}
            </ul>
            <a class="btn btn-primary" href={`/contato?assunto=${encodeURIComponent(s.name)}`}>
              Solicitar proposta<span class="visually-hidden"> de {s.name}</span>
            </a>
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand />
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .jump a {
    display: inline-block;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .jump a:hover {
    border-color: var(--orange);
  }
  .service + .service {
    border-top: 1px solid var(--line);
  }
  .service-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .flip .service-grid {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  }
  .flip .service-art {
    order: 2;
  }
  .service-art {
    width: 100%;
    max-width: 340px;
    justify-self: center;
  }
  .service-art :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .service-copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .pitch {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 36ch;
  }
  .features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 2rem;
    margin: 0.5rem 0 1rem;
    padding: 0;
    list-style: none;
    width: 100%;
  }
  .features li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .features :global(.icon) {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: 0.2rem;
    color: var(--orange-ink);
  }
  @media (max-width: 820px) {
    .service-grid,
    .flip .service-grid {
      grid-template-columns: 1fr;
    }
    .flip .service-art {
      order: 0;
    }
    .service-art {
      max-width: 200px;
      justify-self: start;
    }
  }
  @media (max-width: 520px) {
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
