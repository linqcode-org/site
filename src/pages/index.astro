---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import Icon from "../components/Icon.astro";
import ServiceArt from "../components/ServiceArt.astro";
import ContactForm from "../components/ContactForm.astro";
import { company, hero, services, coreServices, core, whatWeDoIntro, howWeWork, technologies, testimonial } from "../data/site";
import { clients } from "../data/clients";
import { servicesLd } from "../data/structured";
import funeraria from "../assets/clients/logo-funeraria.png";

const homeClients = clients.filter((c) => c.onHome);
// Short names the old home page used for the four services; the hero places one at each petal.
const petalLabels = ["Web sites", "E-commerce", "Mobile", "Custom app"];
---

<Base
  title="Linqcode | Consultoria e desenvolvimento de sistemas sob medida"
  description="Consultoria e desenvolvimento de sistemas sob medida: web sites, e-commerce, aplicativos mobile, aplicações customizadas, inteligência artificial e cloud para unificar os processos da sua empresa."
  schema={servicesLd()}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>{hero.title}</h1>
        <p class="lede">{hero.subtitle}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/contato">Entre em contato</a>
          <a class="btn btn-quiet" href="/solucoes">Conheça nossas soluções</a>
        </div>
      </div>
      <div class="hero-mark">
        <Mark id="hero" assemble class="hero-symbol" />
        <span class="core-label">IA + Cloud</span>
        <ul class="petal-labels" aria-label="O que desenvolvemos">
          {petalLabels.map((label, i) => <li class={`pl pl${i}`}>{label}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="o-que-fazemos" class="what">
    <div class="wrap">
      <div class="section-head">
        <h2>O que fazemos</h2>
        <p>{whatWeDoIntro}</p>
      </div>
      <div class="quad">
        {
          services.map((s, i) => (
            <article class={`tile t${i}`}>
              <ServiceArt service={s.key} size={180} class="tile-art" />
              <div class="tile-copy">
                <h3>{s.name}</h3>
                <p>{s.short}</p>
                <a class="text-link" href={`/solucoes#${s.anchor}`}>
                  Saiba mais<span class="visually-hidden"> sobre {s.name}</span>
                </a>
              </div>
            </article>
          ))
        }
        <div class="quad-hub" aria-hidden="true"><Mark id="hub" /></div>
      </div>
      <div class="core on-night">
        <div class="core-head">
          <span class="core-square" aria-hidden="true"></span>
          <h3>{core.title}</h3>
          <p class="soft">{core.text}</p>
        </div>
        <div class="core-items">
          {
            coreServices.map((s) => (
              <article>
                <ServiceArt service={s.key} size={120} />
                <div>
                  <h4>{s.name}</h4>
                  <p class="soft">{s.short}</p>
                  <a class="text-link" href={`/solucoes#${s.anchor}`}>
                    Saiba mais<span class="visually-hidden"> sobre {s.name}</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="how on-night">
    <div class="wrap how-grid">
      <div>
        <h2>Como fazemos</h2>
        <div class="how-intro soft">
          {howWeWork.intro.map((line) => <p>{line}</p>)}
        </div>
      </div>
      <ul class="principles">
        {
          howWeWork.principles.map((p, i) => (
            <li>
              <svg class="petal-bullet" viewBox="0 0 20 20" aria-hidden="true" style={`transform: rotate(${i * 90}deg)`}>
                <path d="M2 18A16 16 0 0 1 18 2V18Z" fill="url(#pb)" />
              </svg>
              <div>
                <h3>{p.name}</h3>
                <p class="soft">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <svg width="0" height="0" aria-hidden="true" style="position:absolute">
        <defs>
          <linearGradient id="pb" x1="18" y1="18" x2="2" y2="2" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#D2353A" /><stop offset="1" stop-color="#FF6000" />
          </linearGradient>
        </defs>
      </svg>
    </div>
  </section>

  <section class="tech">
    <div class="wrap">
      <div class="section-head">
        <h2>Tecnologias</h2>
        <p>{technologies.intro}</p>
      </div>
      <ul class="tech-grid">
        {
          technologies.areas.map((a) => (
            <li>
              <span class="tech-icon"><Icon name={a.key} /></span>
              <h3>{a.name}</h3>
              <p>{a.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="voice">
    <div class="wrap voice-grid">
      <h2>O que nossos clientes dizem sobre nós</h2>
      <figure>
        <blockquote>
          <p>{testimonial.quote}</p>
        </blockquote>
        <figcaption>
          <Image src={funeraria} alt="" width={56} height={56} />
          <span><strong>{testimonial.author}</strong><br />{testimonial.client}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="clients">
    <div class="wrap">
      <div class="clients-head">
        <h2>Nossos clientes</h2>
        <a class="text-link" href="/clientes">Ver todos os clientes</a>
      </div>
      <ul class="logo-wall">
        {
          homeClients.map((c) => (
            <li>
              <Image src={c.logo} alt={c.name} height={64} width={Math.round((64 * c.logo.width) / c.logo.height)} />
              <span>{c.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="contato" class="contact on-night">
    <div class="wrap contact-grid">
      <div class="contact-copy">
        <h2>Envie seus dados que entraremos em contato com você.</h2>
        <ul class="channels">
          <li>
            <a href={company.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" />{company.phoneDisplay}</a>
          </li>
          <li>
            <a href={`mailto:${company.email}`}><Icon name="mail" />{company.email}</a>
          </li>
        </ul>
      </div>
      <ContactForm dark />
    </div>
  </section>
</Base>

<style>
  /* Hero: the headline on the left, the symbol assembling on the right with one service at each petal. */
  .hero {
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .hero-copy {
    display: grid;
    gap: 1.6rem;
  }
  .hero-copy h1 {
    max-width: 14ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .hero-mark {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .hero-mark :global(.hero-symbol) {
    position: absolute;
    inset: 12%;
    width: 76%;
    height: 76%;
  }
  /* The white square of the symbol is the core: AI and cloud behind every delivery. */
  .hero-mark {
    container-type: inline-size;
  }
  .core-label {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    font-size: 3.4cqi;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .core-label {
      animation: label-in 500ms ease 1050ms both;
    }
  }
  .petal-labels {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pl {
    position: absolute;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 8px 24px -14px rgb(25 28 36 / 0.45);
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
  }
  /* Each label sits at the tip of its petal: left, top, right, bottom. */
  .pl0 { left: 0; top: 18%; }
  .pl1 { right: 4%; top: 4%; }
  .pl2 { right: 0; bottom: 18%; }
  .pl3 { left: 4%; bottom: 4%; }
  @media (prefers-reduced-motion: no-preference) {
    .pl {
      animation: label-in 500ms ease both;
    }
    .pl0 { animation-delay: 1150ms; }
    .pl1 { animation-delay: 1250ms; }
    .pl2 { animation-delay: 1350ms; }
    .pl3 { animation-delay: 1450ms; }
  }
  @keyframes label-in {
    from { opacity: 0; transform: scale(0.85); }
    to { opacity: 1; transform: none; }
  }

  /* O que fazemos: four tiles around one hub, the way the four petals link around the square. */
  .what {
    background: var(--mist);
  }
  .quad {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .tile {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: #fff;
    border-radius: var(--radius);
  }
  .t0 { border-bottom-right-radius: 96px; }
  .t1 { border-bottom-left-radius: 96px; }
  .t2 { border-top-right-radius: 96px; }
  .t3 { border-top-left-radius: 96px; }
  .t0, .t2 { padding-right: clamp(2rem, 6vw, 4.5rem); }
  .t1, .t3 { padding-left: clamp(2rem, 6vw, 4.5rem); }
  .tile :global(.tile-art) {
    width: clamp(110px, 13vw, 180px);
    height: auto;
  }
  .tile-copy {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  .tile-copy p {
    color: var(--ink-soft);
  }
  .quad-hub {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 92px;
    height: 92px;
    translate: -50% -50%;
    padding: 10px;
    border-radius: 50%;
    background: var(--mist);
  }

  .core {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: var(--radius);
  }
  .core-head {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .core-square {
    width: 2.25rem;
    height: 2.25rem;
    background: #fff;
    box-shadow: 0 0 0 6px rgb(255 96 0 / 0.9);
    margin: 6px 0 0.5rem 6px;
  }
  .core-head h3 {
    font-size: var(--step-2);
    max-width: 18ch;
  }
  .core-items {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .core-items article {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    background: var(--night-2);
  }
  .core-items article > div {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .core-items :global(img) {
    width: 96px;
    height: auto;
  }
  .core-items h4 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .core .text-link {
    color: var(--on-night);
  }

  /* Como fazemos */
  .how-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }
  .how-intro {
    display: grid;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 34ch;
  }
  .principles {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .principles li {
    display: flex;
    gap: 1.25rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--night-line);
  }
  .principles li:last-child {
    border-bottom: 1px solid var(--night-line);
  }
  .principles .petal-bullet {
    margin-top: 0.3rem;
  }
  .principles h3 {
    font-size: var(--step-2);
    margin-bottom: 0.4rem;
  }

  /* Tecnologias */
  .tech-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 2rem;
  }
  .tech-grid li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1rem;
    row-gap: 0.25rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
  }
  .tech-icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: rgb(255 96 0 / 0.1);
    color: var(--orange-ink);
  }
  .tech-icon :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
  }
  .tech-grid p {
    color: var(--ink-soft);
  }

  /* Depoimento */
  .voice {
    background: var(--mist);
  }
  .voice-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .voice h2 {
    font-size: var(--step-2);
    max-width: 16ch;
  }
  figure {
    margin: 0;
  }
  blockquote {
    margin: 0;
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    line-height: 1.3;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  blockquote p::before {
    content: "“";
    color: var(--orange);
  }
  blockquote p::after {
    content: "”";
    color: var(--orange);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.75rem;
    color: var(--ink-soft);
  }
  figcaption img {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    object-fit: cover;
  }
  figcaption strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* Clientes */
  .clients-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
  }
  .logo-wall {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .logo-wall li {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.75rem;
    min-height: 10rem;
    padding: 1.5rem 1rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-align: center;
  }
  .logo-wall img {
    width: auto;
    max-width: 150px;
    height: 56px;
    object-fit: contain;
  }
  .logo-wall span {
    font-size: var(--step--1);
    color: var(--ink-mute);
  }

  /* Contato */
  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }
  .contact-copy h2 {
    max-width: 16ch;
  }
  .channels {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.9rem;
  }
  .channels a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--on-night);
    font-size: var(--step-1);
    text-decoration: none;
  }
  .channels a:hover {
    color: var(--orange);
  }
  .channels :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--orange);
  }

  @media (max-width: 960px) {
    .tile {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 860px) {
    .core,
    .core-items {
      grid-template-columns: 1fr;
    }
    .hero-grid,
    .how-grid,
    .voice-grid,
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .hero-mark {
      width: min(100%, 320px);
    }
    .logo-wall {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .quad {
      grid-template-columns: 1fr;
    }
    .tile,
    .t0,
    .t1,
    .t2,
    .t3 {
      grid-template-columns: auto 1fr;
      padding: 1.25rem;
      border-radius: var(--radius);
    }
    .tile :global(.tile-art) {
      width: 96px;
    }
    .quad-hub {
      display: none;
    }
    .tech-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
