---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { nav } from "../data/site";
---

<Base title="Página não encontrada | Linqcode" description="Esta página não existe ou mudou de endereço." noindex>
  <section>
    <div class="wrap box">
      <Mark id="nf" class="nf-mark" />
      <h1>Esta página não existe ou mudou de endereço.</h1>
      <p class="lede">Escolha por onde continuar:</p>
      <ul>
        <li><a class="btn btn-primary" href="/">Início</a></li>
        {nav.map((item) => <li><a class="btn btn-quiet" href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .box {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .box :global(.nf-mark) {
    width: 88px;
  }
  h1 {
    font-size: var(--step-3);
    max-width: 20ch;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
